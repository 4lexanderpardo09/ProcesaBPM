# /etc/procesabpm/backup.env (chmod 600): settings of the daily backup (docs/operations/backups.md). No AWS keys here: the
# server uses its EC2 instance role, which may only write under this prefix.
BACKUP_S3_URI=s3://procesabpm-backups-CHANGE-ME/postgres
AWS_REGION=us-east-1
# AES256 (S3-managed keys) or aws:kms with BACKUP_KMS_KEY_ID.
BACKUP_SSE=AES256
# BACKUP_KMS_KEY_ID=arn:aws:kms:us-east-1:111122223333:key/…
# Where the compose file of the deployment lives.
BACKUP_COMPOSE_DIR=/opt/procesabpm
COMPOSE_FILE=docker-compose.prod.example.yml
# Local copies kept for a quick restore (the bucket keeps the history).
BACKUP_LOCAL_KEEP=2
