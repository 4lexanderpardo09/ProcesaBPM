# The reverse proxy in front of ProcesaBPM (docs/despliegue.md): HTTPS with automatic certificates, the API under /api
# (its routes, health checks and the /api/realtime WebSocket) and the web for everything else, on one origin.
# Copy it to /etc/caddy/Caddyfile, change the host names and reload: sudo systemctl reload caddy
#
# The public website (apps/landing) lives on its own host. Its demo form posts to /api/public/*, the only part of the API
# it reaches; the rest of the API stays on the app's host.
www.example.com, example.com {
	encode zstd gzip

	handle /api/public/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:8081
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Report-only first (docs/despliegue.md): the browser logs violations to the console but blocks nothing. Watch for a
		# week, add any real source, then rename the header to Content-Security-Policy to enforce. Google Analytics loads only
		# after consent, so its domains appear here; Google Fonts needs fonts.googleapis.com (CSS) and fonts.gstatic.com (files).
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https://www.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com"
		-Server
		-X-Powered-By
	}
}

app.example.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			# Reloading the configuration does not drop every WebSocket at once.
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Report-only first (see the landing block). The app is a React SPA on one origin; it also uploads/downloads files to
		# the S3-compatible storage with presigned URLs, so when enforcing, add that storage host to connect-src and img-src.
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'; connect-src 'self'"
		-Server
		-X-Powered-By
	}
}
