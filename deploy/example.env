# Values for docker-compose.prod.example.yml. EXAMPLE ONLY: generate your own secrets (openssl rand -base64 48) and keep
# the real file out of the repository (.env is ignored by git and by the Docker build context).
# Database passwords go inside connection URLs: generate them with `openssl rand -hex 32` (base64 can produce `/` or `+`, which
# break the URL unless encoded). The other secrets can use `openssl rand -base64 48`.
IMAGE_TAG=latest

DB_OWNER_PASSWORD=change-me
API_DB_PASSWORD=change-me
WORKER_DB_PASSWORD=change-me
PLATFORM_DB_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-bytes-long-0000000000
# AES-256 keys of the stored MFA secrets, "id:base64" separated by commas (the first one encrypts, all decrypt). Only the API.
# Generate one with:  echo "k$(date +%Y%m):$(openssl rand -base64 32)"
# To rotate: put a new key first and keep the old one until no secret uses it (docs/despliegue.md, "Rotar la llave de MFA").
MFA_ENCRYPTION_KEYS=change-me:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OUTBOX_TOKEN_KEY=change-me-at-least-32-bytes-long-0000000000

WEB_BASE_URL=https://app.example.com
# Origins allowed to open the realtime WebSocket (comma-separated, no path). Defaults to WEB_BASE_URL.
# REALTIME_ALLOWED_ORIGINS=https://app.example.com
# «Crear con IA» (docs/arquitectura.md §22). Off unless AI_ASSISTANT_AVAILABLE=true; each organization then turns it on and
# accepts the notice that descriptions go to the provider. The key goes only to the worker.
# AI_ASSISTANT_AVAILABLE=true
# AI_API_KEY=sk-...
# AI_REASONING_MODEL=deepseek-v4-pro
# AI_DAILY_JOBS_PER_TENANT=10
# AI_DAILY_TOKENS_PER_TENANT=1000000
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_BUCKET=procesabpm
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
