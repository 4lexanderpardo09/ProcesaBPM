# Values for docker-compose.prod.example.yml. EXAMPLE ONLY: generate your own secrets (openssl rand -base64 48) and keep
# the real file out of the repository (.env is ignored by git and by the Docker build context).
IMAGE_TAG=latest

DB_OWNER_PASSWORD=change-me
API_DB_PASSWORD=change-me
WORKER_DB_PASSWORD=change-me
PLATFORM_DB_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-bytes-long-0000000000
OUTBOX_TOKEN_KEY=change-me-at-least-32-bytes-long-0000000000

WEB_BASE_URL=https://app.example.com
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_BUCKET=procesabpm
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
