# Serves the built landing (apps/landing/dist) on :8080, behind the reverse proxy that terminates TLS (deploy/Caddyfile.example).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Astro names its bundles and images by their content: they can be kept forever.
	handle /_astro/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The pages are asked for again, so a deployment reaches people on their next load. /blog/x is the file blog/x.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
