# Schema owner: only for `pnpm migrate:deploy`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procesabpm
# Runtime login for the API (member of app_runtime, through PgBouncer in transaction mode)
# RUNTIME_DATABASE_URL=postgresql://procesabpm_api:change-me@localhost:6432/procesabpm
# Platform login (member of app_platform): seed, provisioning, purge jobs
# PLATFORM_DATABASE_URL=postgresql://procesabpm_platform:change-me@localhost:5432/procesabpm
