  @@map("deadline_type")
}

enum ParticipantType {
  USER
  POSITION
  GROUP
  DEPARTMENT
  COMPANY
  SITE

  @@map("participant_type")
}

enum SignerType {
  USER
  POSITION
  APPROVER
  CREATOR
  STEP_ASSIGNEE

  @@map("signer_type")
}

enum TransitionType {
