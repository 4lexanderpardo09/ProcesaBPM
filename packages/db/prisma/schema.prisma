}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  SELECT
  MULTI_SELECT
  DATE
  DATETIME
  DAYS
  SITE
  USER
  TABLE
  FILE
  FORMULA
  CALCULATOR

