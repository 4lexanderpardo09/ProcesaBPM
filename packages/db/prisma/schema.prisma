// ProcesaBPM — database schema (PostgreSQL 18)
//
// Conventions (see docs/modelo-datos.md):
// - Every tenant-owned table has `tenant_id` and a composite primary key (tenant_id, id).
//   References between tenant tables use composite foreign keys (tenant_id, x_id) so a row
//   can never point to another tenant's data. Row-Level Security is applied by
//   prisma/sql/rls.sql on every table that has a `tenant_id` column.
// - IDs are UUIDv7 generated by the database (`uuidv7()`), so raw SQL inserts get them too.
// - Intra-tenant foreign keys use NO ACTION so deleting a tenant cascades in one statement.
// - Identifiers are in English; end-user text lives in the frontend i18n files.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED

  @@map("tenant_status")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED

  @@map("user_status")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
  EMAIL_CHANGE

  @@map("user_token_type")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum SystemRole {
  ADMIN
  SUPERVISOR
  AGENT
  REQUESTER

  @@map("system_role")
}

enum AnnouncementType {
  MAINTENANCE
  RELEASE_NOTES
  INFO

  @@map("announcement_type")
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("workflow_version_status")
}

enum StepType {
  START
  TASK
  APPROVAL
  CONDITION
  DECISION
  DOCUMENT
  SIGNATURE
  EXPORT
  NOTIFICATION
  WEBHOOK
  CALCULATOR
  WAIT
  END

  @@map("step_type")
}

enum AssignmentMode {
  NONE
  POSITION
  USERS
  GROUP
  CREATOR
  APPROVER
  POOL
  PARALLEL
  RANDOM_DISPATCH

  @@map("assignment_mode")
}

enum SiteScope {
  SAME_SITE
  PARENT_SITE
