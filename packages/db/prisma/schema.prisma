  SLA_OVERDUE
  OBSERVER_UPDATE
  STORAGE_QUOTA
  SYSTEM

  @@map("notification_type")
}

/// Where an export column takes its value from (the old plano "origen_tipo").
enum ExportColumnSource {
  FIELD
  DERIVED
  CONSTANT
  COMPANY
  REQUESTER
  TABLE_SUM
  CATALOG
  SEQUENCE
  CUTOFF_DATE
  TICKET_DATE

  @@map("export_column_source")
}

enum ExportValueFormat {
  TRIM
  UPPER
  INTEGER
  INTEGER_OR_EMPTY
  DECIMAL_2
  DATE_DMY

  @@map("export_value_format")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("outbox_status")
}

// ============================================================================
// Platform (global tables — no tenant_id, no RLS)
// ============================================================================

model Plan {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                String   @unique
  name                String
  storageBaseBytes    BigInt   @map("storage_base_bytes")
  storagePerUserBytes BigInt   @map("storage_per_user_bytes")
  storageGracePercent Int      @default(5) @map("storage_grace_percent")
  maxUsers            Int?     @map("max_users")
  /// Feature flags enabled by the plan, e.g. {"exports": true, "webhooks": false}.
  features            Json     @default("{}")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenants Tenant[]

  @@map("plans")
}

model Currency {
  code     String @id @db.Char(3)
  name     String
  decimals Int    @default(2) @db.SmallInt

  countries   Country[]
  companies   Company[]
  amountRules AmountRule[]

  @@map("currencies")
}

model Country {
  code         String @id @db.Char(2)
  name         String
  currencyCode String @map("currency_code") @db.Char(3)
  timeZone     String @map("time_zone")

  currency  Currency         @relation(fields: [currencyCode], references: [code])
  holidays  CountryHoliday[]
  tenants   Tenant[]
  companies Company[]
  calendars Calendar[]

  @@index([currencyCode])
  @@map("countries")
}

model CountryHoliday {
  countryCode String   @map("country_code") @db.Char(2)
  date        DateTime @db.Date
  name        String

  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@id([countryCode, date])
  @@map("country_holidays")
}

model Permission {
  id          String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  action      String
  subject     String
  description String?

  rolePermissions RolePermission[]

  @@unique([action, subject])
  @@map("permissions")
}

/// Global identity. A user can belong to several tenants through Membership.
model User {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email              String     @unique
  passwordHash       String?    @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  documentNumber     String?    @map("document_number")
  status             UserStatus @default(ACTIVE)
  locale             String     @default("es-CO")
  timeZone           String?    @map("time_zone")
  /// TOTP secret encrypted by the application (AES-256-GCM); never stored in clear text.
  mfaSecretEncrypted Bytes?     @map("mfa_secret_encrypted")
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLogins       Int        @default(0) @map("failed_logins")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// Tokens issued before this instant are void (password reset, invitation or change). Not readable by the application role.
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships     Membership[]
  refreshSessions RefreshSession[]
  tokens          UserToken[]
  consumedAuthTokens ConsumedAuthToken[]
  platformAdmin   PlatformAdmin?

  @@map("users")
}

model RefreshSession {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String?   @map("active_tenant_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy     String?   @map("replaced_by") @db.Uuid
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model UserToken {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  type            UserTokenType
  tokenHash       String        @unique @map("token_hash")
  invitedTenantId String?       @map("invited_tenant_id") @db.Uuid
  /// The outbox event that issued this token (worker-issued tokens only): a retry finds its row instead of issuing another.
  sourceEventId   String?       @unique @map("source_event_id") @db.Uuid
  /// Extra data of the token, e.g. {"email": "new@x.com"} for EMAIL_CHANGE.
  payload         Json?
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(3)
  consumedAt      DateTime?     @map("consumed_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

/// Selection and MFA-challenge tokens already used (by jti), so each works once. Platform-only: no application role reads it.
model ConsumedAuthToken {
  jti        String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  purpose    String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("consumed_auth_tokens")
}

model PlatformAdmin {
  userId    String   @id @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

model PlatformAnnouncement {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        AnnouncementType
  title       String
  body        String
  startsAt    DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?        @map("ends_at") @db.Timestamptz(3)
  blocksLogin Boolean          @default(false) @map("blocks_login")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("platform_announcements")
}

// ============================================================================
// Tenant
// ============================================================================

model Tenant {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug              String       @unique
  name              String
  status            TenantStatus @default(ACTIVE)
  planId            String       @map("plan_id") @db.Uuid
  countryCode       String       @map("country_code") @db.Char(2)
  timeZone          String       @map("time_zone")
  extraStorageBytes BigInt       @default(0) @map("extra_storage_bytes")
  dbCluster         String       @default("main") @map("db_cluster")
  primaryColor      String?      @map("primary_color")
  logoFileId        String?      @map("logo_file_id") @db.Uuid
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  purgeAfter        DateTime?    @map("purge_after") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan    Plan    @relation(fields: [planId], references: [id])
  country Country @relation(fields: [countryCode], references: [code])

  usage     TenantUsage?
  sequences TenantSequence[]
  settings  TenantSetting[]

  memberships             Membership[]
  membershipCompanies     MembershipCompany[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  groups                  Group[]
  groupMembers            GroupMember[]
  companies               Company[]
  departments             Department[]
  positions               Position[]
  siteLevels              SiteLevel[]
  sites                   Site[]
  calendars               Calendar[]
  calendarWorkingHours    CalendarWorkingHours[]
  calendarHolidays        CalendarHoliday[]
  approvalGroupTypes      ApprovalGroupType[]
  approvalGroups          ApprovalGroup[]
  approvalGroupApprovers  ApprovalGroupApprover[]
  approvalGroupMembers    ApprovalGroupMember[]
  delegations             Delegation[]
  priorities              Priority[]
  categories              Category[]
  categoryCompanies       CategoryCompany[]
  categoryDepartments     CategoryDepartment[]
  subcategories           Subcategory[]
  workflows               Workflow[]
  workflowObservers       WorkflowObserver[]
  workflowVersions        WorkflowVersion[]
  steps                   Step[]
  stepCandidates          StepCandidate[]
  stepInitiators          StepInitiator[]
  stepSlaOverrides        StepSlaOverride[]
  stepSigners             StepSigner[]
  stepFiles               StepFile[]
  transitions             Transition[]
  fields                  Field[]
  amountRules             AmountRule[]
  companyCutoffs          CompanyCutoff[]
  datasets                Dataset[]
  datasetRows             DatasetRow[]
  calculatorConfigs       CalculatorConfig[]
  tickets                 Ticket[]
  ticketAssignees         TicketAssignee[]
  ticketStepVisits        TicketStepVisit[]
  stepRuntimeStates       StepRuntimeState[]
  notificationPreferences NotificationPreference[]
  ticketEvents            TicketEvent[]
  ticketSlaClocks         TicketSlaClock[]
  ticketFieldValues       TicketFieldValue[]
  ticketParallelTasks     TicketParallelTask[]
  ticketIncidents         TicketIncident[]
  errorTypes              ErrorType[]
  errorSubtypes           ErrorSubtype[]
  ticketErrors            TicketError[]
  tags                    Tag[]
  ticketTags              TicketTag[]
  ticketSignatures        TicketSignature[]
  storedFiles             StoredFile[]
  ticketDocuments         TicketDocument[]
  pdfFormats              PdfFormat[]
  pdfTemplates            PdfTemplate[]
  pdfTemplateFields       PdfTemplateField[]
  pdfTemplateSignatures   PdfTemplateSignature[]
  workflowDocuments       WorkflowDocument[]
  exportDefinitions       ExportDefinition[]
  exportColumns           ExportColumn[]
  exportCatalogEntries    ExportCatalogEntry[]
  exportCutoffs           ExportCutoff[]
  exportLines             ExportLine[]
  notifications           Notification[]
  outboxEvents            OutboxEvent[]
  webhooks                Webhook[]
  webhookDeliveries       WebhookDelivery[]
  auditLogs               AuditLog[]
  textTemplates           TextTemplate[]
  textTemplateShares      TextTemplateShare[]

  @@index([status])
  @@index([countryCode])
  @@index([planId])
  @@map("tenants")
}

/// Storage counter per tenant (see docs/analisis.md §7.4). Reconciled nightly.
model TenantUsage {
  tenantId      String   @id @map("tenant_id") @db.Uuid
  bytesUsed     BigInt   @default(0) @map("bytes_used")
  bytesReserved BigInt   @default(0) @map("bytes_reserved")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_usage")
}

/// Human-readable counters per tenant, e.g. the ticket number (#1045).
model TenantSequence {
  tenantId  String @map("tenant_id") @db.Uuid
  name      String
  lastValue BigInt @default(0) @map("last_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("tenant_sequences")
}

model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

// ============================================================================
// Identity inside a tenant
// ============================================================================

/// A user's membership in a tenant. Every actor/assignee column in tenant tables
/// references (tenant_id, user_id) here, so only members of the tenant can be used.
model Membership {
  tenantId        String           @map("tenant_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  roleId          String           @map("role_id") @db.Uuid
  positionId      String?          @map("position_id") @db.Uuid
  departmentId    String?          @map("department_id") @db.Uuid
  siteId          String?          @map("site_id") @db.Uuid
  status          MembershipStatus @default(INVITED)
  isOwner         Boolean          @default(false) @map("is_owner")
  signatureFileId String?          @map("signature_file_id") @db.Uuid
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: NoAction)
  position      Position?   @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  department    Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  site          Site?       @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: NoAction)
  signatureFile StoredFile? @relation("MembershipSignature", fields: [tenantId, signatureFileId], references: [tenantId, id], onDelete: NoAction)

  companies               MembershipCompany[]
  groupMembers            GroupMember[]
  approverOf              ApprovalGroupApprover[]
  approvalMemberships     ApprovalGroupMember[]
  delegationsGiven        Delegation[]             @relation("DelegationFrom")
  delegationsReceived     Delegation[]             @relation("DelegationTo")
  workflowObservers       WorkflowObserver[]
  publishedVersions       WorkflowVersion[]
  stepCandidates          StepCandidate[]
  stepInitiators          StepInitiator[]
  stepSigners             StepSigner[]
  ticketsCreated          Ticket[]                 @relation("TicketCreator")
  ticketsRegistered       Ticket[]                 @relation("TicketRegisteredBy")
  ticketsClosed           Ticket[]                 @relation("TicketClosedBy")
  ticketAssignments       TicketAssignee[]
  ticketEventsActed       TicketEvent[]            @relation("TicketEventActor")
  ticketEventsAssigned    TicketEvent[]            @relation("TicketEventAssignee")
  slaClocks               TicketSlaClock[]
  fieldValuesUpdated      TicketFieldValue[]
  parallelTasks           TicketParallelTask[]
  incidentsCreated        TicketIncident[]         @relation("IncidentCreator")
  incidentsAssigned       TicketIncident[]         @relation("IncidentAssignee")
  errorsReported          TicketError[]            @relation("ErrorReporter")
  errorsResponsible       TicketError[]            @relation("ErrorResponsible")
  tags                    Tag[]
  ticketTags              TicketTag[]
  ticketSignatures        TicketSignature[]
  filesUploaded           StoredFile[]             @relation("FileUploader")
  pdfFormatsUpdated       PdfFormat[]
  exportCutoffs           ExportCutoff[]
  exportLinesConfirmed    ExportLine[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  textTemplates           TextTemplate[]
  textTemplateShares      TextTemplateShare[]
  stepRuntimeStates       StepRuntimeState[]

  @@id([tenantId, userId])
  @@index([userId])
  @@index([tenantId, roleId])
  @@index([tenantId, positionId])
  @@index([tenantId, siteId])
  @@index([tenantId, departmentId])
  @@index([tenantId, signatureFileId])
  @@map("memberships")
}

model MembershipCompany {
  tenantId  String @map("tenant_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  company    Company    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)

  ticketsCreated Ticket[]

  @@id([tenantId, userId, companyId])
  @@index([tenantId, companyId])
  @@map("membership_companies")
}

model Role {
  tenantId    String      @map("tenant_id") @db.Uuid
  id          String      @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  description String?
  systemRole  SystemRole? @map("system_role")
  isAdmin     Boolean     @default(false) @map("is_admin")
  isActive    Boolean     @default(true) @map("is_active")
  /// Bumped by a trigger on any change of role_permissions; the ability cache is keyed by it.
  permissionsVersion Int @default(0) @map("permissions_version")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

/// `conditions` holds CASL conditions (e.g. {"creatorId":"${user.id}"}) for record-level rules.
model RolePermission {
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  conditions   Json?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Free user groups (the old "perfiles"), used for initiators, candidates and observers.
model Group {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members GroupMember[]

  stepCandidates    StepCandidate[]
  stepInitiators    StepInitiator[]
  workflowObservers WorkflowObserver[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("groups")
}

model GroupMember {
  tenantId String @map("tenant_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group      Group      @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, groupId, userId])
  @@index([tenantId, userId])
  @@map("group_members")
}

// ============================================================================
// Organization
// ============================================================================

model Company {
  tenantId     String   @map("tenant_id") @db.Uuid
  id           String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  taxId        String?  @map("tax_id")
  isDefault    Boolean  @default(false) @map("is_default")
  countryCode  String   @map("country_code") @db.Char(2)
  currencyCode String   @map("currency_code") @db.Char(3)
  timeZone     String   @map("time_zone")
  calendarId   String?  @map("calendar_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country  Country   @relation(fields: [countryCode], references: [code])
  currency Currency  @relation(fields: [currencyCode], references: [code])
  calendar Calendar? @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: NoAction)

  memberships       MembershipCompany[]
  approvalGroups    ApprovalGroup[]
  approvalMembers   ApprovalGroupMember[]
  categories        CategoryCompany[]
  stepInitiators    StepInitiator[]
  stepSlaOverrides  StepSlaOverride[]
  amountRules       AmountRule[]
  companyCutoffs    CompanyCutoff[]
  tickets           Ticket[]
  slaClocks         TicketSlaClock[]
  storedFiles       StoredFile[]
  pdfTemplates      PdfTemplate[]
  workflowDocuments WorkflowDocument[]
  exportDefinitions ExportDefinition[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([countryCode])
  @@index([currencyCode])
  @@index([tenantId, calendarId])
  @@map("companies")
}

model Department {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  categories     CategoryDepartment[]
  stepInitiators StepInitiator[]
  tickets        Ticket[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("departments")
}

/// Job position (the old "cargo"). Used to assign work in steps, not to approve.
model Position {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  steps          Step[]
  stepCandidates StepCandidate[]
  stepInitiators StepInitiator[]
  stepSigners    StepSigner[]
  amountRules    AmountRule[]
  observers      WorkflowObserver[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("positions")
}

/// Configurable names for each level of the site tree (e.g. 1 = "Zona", 2 = "Regional").
model SiteLevel {
  tenantId String @map("tenant_id") @db.Uuid
  level    Int
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, level])
  @@map("site_levels")
}

/// Hierarchical sites (replaces the old regional/zone pair).
model Site {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  level     Int
  name      String
  isCentral Boolean  @default(false) @map("is_central")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Site?  @relation("SiteTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: NoAction)
  children Site[] @relation("SiteTree")

  memberships    Membership[]
  stepInitiators StepInitiator[]
  tickets        Ticket[]

  @@id([tenantId, id])
  @@unique([tenantId, parentId, name])
  @@index([tenantId, parentId])
  @@map("sites")
}

model Calendar {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String
  countryCode String?  @map("country_code") @db.Char(2)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  country      Country?               @relation(fields: [countryCode], references: [code])
  workingHours CalendarWorkingHours[]
  holidays     CalendarHoliday[]
  companies    Company[]
  stepVisits   TicketStepVisit[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([countryCode])
  @@map("calendars")
}

/// One row per working shift; a day can have several (e.g. 08:00-12:00 and 14:00-18:00).
model CalendarWorkingHours {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuidv7()")) @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  weekday    Int      @db.SmallInt
  startTime  DateTime @map("start_time") @db.Time(0)
  endTime    DateTime @map("end_time") @db.Time(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, calendarId, weekday])
  @@map("calendar_working_hours")
}

model CalendarHoliday {
  tenantId   String   @map("tenant_id") @db.Uuid
  calendarId String   @map("calendar_id") @db.Uuid
  date       DateTime @db.Date
  name       String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar Calendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, calendarId, date])
  @@map("calendar_holidays")
}

// ----------------------------------------------------------------------------
// Approval groups ("X approves Y, Z and J"), see docs/analisis.md §10
// ----------------------------------------------------------------------------

model ApprovalGroupType {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  groups  ApprovalGroup[]
  members ApprovalGroupMember[]
  steps   Step[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("approval_group_types")
}

model ApprovalGroup {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  typeId    String   @map("type_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      ApprovalGroupType       @relation(fields: [tenantId, typeId], references: [tenantId, id], onDelete: NoAction)
  company   Company?                @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  approvers ApprovalGroupApprover[]
  members   ApprovalGroupMember[]

  @@id([tenantId, id])
  @@unique([tenantId, typeId, id])
  @@unique([tenantId, name])
  @@index([tenantId, companyId])
  @@map("approval_groups")
}

/// Ordered approvers of a group: position 1 is the primary, the rest are substitutes.
model ApprovalGroupApprover {
  tenantId String @map("tenant_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  position Int    @db.SmallInt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group      ApprovalGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  membership Membership    @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, groupId, userId])
  @@unique([tenantId, groupId, position])
  @@index([tenantId, userId])
  @@map("approval_group_approvers")
}

/// `typeId` and `companyId` are copied from the group (a trigger keeps them in sync) so the
/// database enforces: one group per type per user and company. A group without company
/// applies to every company; a company-specific group wins over it.
model ApprovalGroupMember {
  tenantId  String  @map("tenant_id") @db.Uuid
  groupId   String  @map("group_id") @db.Uuid
  typeId    String  @map("type_id") @db.Uuid
  companyId String? @map("company_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group      ApprovalGroup     @relation(fields: [tenantId, typeId, groupId], references: [tenantId, typeId, id], onDelete: Cascade)
  type       ApprovalGroupType @relation(fields: [tenantId, typeId], references: [tenantId, id], onDelete: NoAction)
  company    Company?          @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  membership Membership        @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, groupId, userId])
  @@index([tenantId, companyId])
  @@index([tenantId, typeId, groupId])
  @@index([tenantId, typeId])
  @@index([tenantId, userId])
  @@unique([tenantId, typeId, companyId, userId], map: "approval_members_one_group")
  @@map("approval_group_members")
}

model Delegation {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuidv7()")) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(3)
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUser Membership @relation("DelegationFrom", fields: [tenantId, fromUserId], references: [tenantId, userId], onDelete: Cascade)
  toUser   Membership @relation("DelegationTo", fields: [tenantId, toUserId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, fromUserId, startsAt, endsAt])
  @@index([tenantId, toUserId])
  @@map("delegations")
}

// ============================================================================
// Catalog
// ============================================================================

model Priority {
  tenantId  String  @map("tenant_id") @db.Uuid
  id        String  @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  color     String?
  isActive  Boolean @default(true) @map("is_active")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  tickets       Ticket[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("priorities")
}

model Category {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  companies     CategoryCompany[]
  departments   CategoryDepartment[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("categories")
}

/// Category visibility by company. No rows = visible in every company.
model CategoryCompany {
  tenantId   String @map("tenant_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  company  Company  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, categoryId, companyId])
  @@index([tenantId, companyId])
  @@map("category_companies")
}

/// Category visibility by department. No rows = visible in every department.
model CategoryDepartment {
  tenantId     String @map("tenant_id") @db.Uuid
  categoryId   String @map("category_id") @db.Uuid
  departmentId String @map("department_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  department Department @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, categoryId, departmentId])
  @@index([tenantId, departmentId])
  @@map("category_departments")
}

model Subcategory {
  tenantId          String   @map("tenant_id") @db.Uuid
  id                String   @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  defaultPriorityId String?  @map("default_priority_id") @db.Uuid
  name              String
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: NoAction)
  defaultPriority Priority? @relation(fields: [tenantId, defaultPriorityId], references: [tenantId, id], onDelete: NoAction)
  workflow        Workflow?
  tickets         Ticket[]

  @@id([tenantId, id])
  @@unique([tenantId, categoryId, name])
  @@index([tenantId, defaultPriorityId])
  @@map("subcategories")
}

// ============================================================================
// Workflow engine (versioned), see docs/analisis.md §3.7 and §13
// ============================================================================

model Workflow {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @default(dbgenerated("uuidv7()")) @db.Uuid
  subcategoryId String   @map("subcategory_id") @db.Uuid
  name          String
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [tenantId, subcategoryId], references: [tenantId, id], onDelete: NoAction)

  versions          WorkflowVersion[]
  tickets           Ticket[]
  observers         WorkflowObserver[]
  companyCutoffs    CompanyCutoff[]
  datasets          Dataset[]
  pdfFormats        PdfFormat[]
  pdfTemplates      PdfTemplate[]
  workflowDocuments WorkflowDocument[]
  exportDefinitions ExportDefinition[]

  @@id([tenantId, id])
  @@unique([tenantId, subcategoryId])
  @@unique([tenantId, subcategoryId, id])
  @@map("workflows")
}

/// Users, positions or groups notified of every movement of the workflow's tickets.
model WorkflowObserver {
  tenantId        String          @map("tenant_id") @db.Uuid
  id              String          @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId      String          @map("workflow_id") @db.Uuid
  participantType ParticipantType @map("participant_type")
  userId          String?         @map("user_id") @db.Uuid
  positionId      String?         @map("position_id") @db.Uuid
  groupId         String?         @map("group_id") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow    @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  membership Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)
  position   Position?   @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  group      Group?      @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, workflowId])
  @@index([tenantId, groupId])
  @@index([tenantId, positionId])
  @@index([tenantId, userId])
  @@map("workflow_observers")
}

/// Published versions are immutable; tickets keep the version they started with.
model WorkflowVersion {
  tenantId      String                @map("tenant_id") @db.Uuid
  id            String                @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId    String                @map("workflow_id") @db.Uuid
  number        Int
  status        WorkflowVersionStatus @default(DRAFT)
  notes         String?
  publishedAt   DateTime?             @map("published_at") @db.Timestamptz(3)
  publishedById String?               @map("published_by_id") @db.Uuid
  /// Bumped by every save of the canvas: optimistic concurrency (a stale save is refused).
  revision      Int                   @default(0)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow    Workflow    @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  publishedBy Membership? @relation(fields: [tenantId, publishedById], references: [tenantId, userId], onDelete: NoAction)

  steps       Step[]
  transitions Transition[]
  fields      Field[]
  amountRules AmountRule[]
  tickets     Ticket[]

  @@id([tenantId, id])
  @@unique([tenantId, workflowId, number])
  @@unique([tenantId, workflowId, id])
  @@index([tenantId, publishedById])
  @@map("workflow_versions")
}

/// A block on the flow canvas. Typed columns hold what the engine queries;
/// `config` holds block-specific settings validated by zod schemas in packages/shared.
model Step {
  tenantId             String         @map("tenant_id") @db.Uuid
  id                   String         @default(dbgenerated("uuidv7()")) @db.Uuid
  versionId            String         @map("version_id") @db.Uuid
  type                 StepType
  name                 String
  description          String?
  assignmentMode       AssignmentMode @default(NONE) @map("assignment_mode")
  manualSelection      Boolean        @default(false) @map("manual_selection")
  siteScope            SiteScope      @default(SAME_SITE) @map("site_scope")
  positionId           String?        @map("position_id") @db.Uuid
  approvalGroupTypeId  String?        @map("approval_group_type_id") @db.Uuid
  approvalLevel        Int?           @map("approval_level") @db.SmallInt
  closeRule            CloseRule      @default(NOT_ALLOWED) @map("close_rule")
  slaValue             Int?           @map("sla_value")
  slaUnit              SlaUnit?       @map("sla_unit")
  deadlineType         DeadlineType   @default(SLA) @map("deadline_type")
  deadlineFieldCode    String?        @map("deadline_field_code")
  deadlineBusinessDays Int?           @map("deadline_business_days")
  maxLoops             Int?           @map("max_loops")
  dispatchIntervalMin  Int?           @map("dispatch_interval_min")
  allowsBatch          Boolean        @default(false) @map("allows_batch")
  config               Json           @default("{}")
  uiX                  Float          @default(0) @map("ui_x")
  uiY                  Float          @default(0) @map("ui_y")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version           WorkflowVersion    @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  position          Position?          @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  approvalGroupType ApprovalGroupType? @relation(fields: [tenantId, approvalGroupTypeId], references: [tenantId, id], onDelete: NoAction)

  runtimeState     StepRuntimeState?
  candidates       StepCandidate[]
  initiators       StepInitiator[]
  slaOverrides     StepSlaOverride[]
  signers          StepSigner[]
  files            StepFile[]
  outgoing         Transition[]         @relation("TransitionFrom")
  incoming         Transition[]         @relation("TransitionTo")
  fields           Field[]
  amountRules      AmountRule[]         @relation("AmountRuleStep")
  amountApprovals  AmountRule[]         @relation("AmountRuleApprovalStep")
  ticketsHere      Ticket[]
  ticketEvents     TicketEvent[]
  stepVisits       TicketStepVisit[]
  slaClocks        TicketSlaClock[]
  parallelTasks    TicketParallelTask[]
  incidents        TicketIncident[]
  ticketSignatures TicketSignature[]
  ticketDocuments  TicketDocument[]

  @@id([tenantId, id])
  @@unique([tenantId, versionId, id])
  @@index([tenantId, versionId])
  @@index([tenantId, approvalGroupTypeId])
  @@index([tenantId, positionId])
  @@map("steps")
}

/// Operational state of a step, kept apart from its (immutable) configuration:
/// last random-dispatch run and the round-robin pointer.
model StepRuntimeState {
  tenantId           String    @map("tenant_id") @db.Uuid
  stepId             String    @map("step_id") @db.Uuid
  lastDispatchAt     DateTime? @map("last_dispatch_at") @db.Timestamptz(3)
  lastAssignedUserId String?   @map("last_assigned_user_id") @db.Uuid

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step             Step        @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  lastAssignedUser Membership? @relation(fields: [tenantId, lastAssignedUserId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, stepId])
  @@index([tenantId, lastAssignedUserId])
  @@map("step_runtime_states")
}

/// Explicit candidates of a step (assignment mode USERS / GROUP / POSITION lists).
model StepCandidate {
  tenantId        String          @map("tenant_id") @db.Uuid
  id              String          @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId          String          @map("step_id") @db.Uuid
  participantType ParticipantType @map("participant_type")
  userId          String?         @map("user_id") @db.Uuid
  positionId      String?         @map("position_id") @db.Uuid
  groupId         String?         @map("group_id") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step       Step        @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  membership Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)
  position   Position?   @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  group      Group?      @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, stepId])
  @@index([tenantId, groupId])
  @@index([tenantId, positionId])
  @@index([tenantId, userId])
  @@map("step_candidates")
}

/// Who may start a ticket at an entry step. No rows = anyone in the tenant.
/// Replaces the old ReglaMapeo + tm_flujo_paso_iniciadores.
model StepInitiator {
  tenantId        String          @map("tenant_id") @db.Uuid
  id              String          @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId          String          @map("step_id") @db.Uuid
  participantType ParticipantType @map("participant_type")
  userId          String?         @map("user_id") @db.Uuid
  positionId      String?         @map("position_id") @db.Uuid
  groupId         String?         @map("group_id") @db.Uuid
  departmentId    String?         @map("department_id") @db.Uuid
  companyId       String?         @map("company_id") @db.Uuid
  siteId          String?         @map("site_id") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step       Step        @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  membership Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)
  position   Position?   @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  group      Group?      @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: NoAction)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  company    Company?    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  site       Site?       @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, stepId])
  @@index([tenantId, companyId])
  @@index([tenantId, departmentId])
  @@index([tenantId, groupId])
  @@index([tenantId, positionId])
  @@index([tenantId, siteId])
  @@index([tenantId, userId])
  @@map("step_initiators")
}

model StepSlaOverride {
  tenantId  String  @map("tenant_id") @db.Uuid
  stepId    String  @map("step_id") @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  slaValue  Int     @map("sla_value")
  slaUnit   SlaUnit @map("sla_unit")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step    Step    @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, stepId, companyId])
  @@index([tenantId, companyId])
  @@map("step_sla_overrides")
}

/// Required signers of a step (parallel signatures and PDF signature slots).
model StepSigner {
  tenantId   String     @map("tenant_id") @db.Uuid
  id         String     @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId     String     @map("step_id") @db.Uuid
  signerType SignerType @map("signer_type")
  userId     String?    @map("user_id") @db.Uuid
  positionId String?    @map("position_id") @db.Uuid
  label      String?
  sortOrder  Int        @default(0) @map("sort_order")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step       Step        @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  membership Membership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)
  position   Position?   @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, stepId])
  @@index([tenantId, positionId])
  @@index([tenantId, userId])
  @@map("step_signers")
}

/// Downloadable files offered in a step (forms to fill, instructions).
model StepFile {
  tenantId  String @map("tenant_id") @db.Uuid
  stepId    String @map("step_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  step   Step       @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: Cascade)
  file   StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, stepId, fileId])
  @@index([tenantId, fileId])
  @@map("step_files")
}

/// Edge between two steps of the same version. `condition` holds the automatic
/// branch rule for CONDITION transitions ([{field, op, value}] evaluated with AND).
model Transition {
  tenantId   String         @map("tenant_id") @db.Uuid
  id         String         @default(dbgenerated("uuidv7()")) @db.Uuid
  versionId  String         @map("version_id") @db.Uuid
  fromStepId String         @map("from_step_id") @db.Uuid
  toStepId   String         @map("to_step_id") @db.Uuid
  type       TransitionType @default(DECISION)
  label      String
  condition  Json?
  sortOrder  Int            @default(0) @map("sort_order")
  uiPoints   Json?          @map("ui_points")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version  WorkflowVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  fromStep Step            @relation("TransitionFrom", fields: [tenantId, versionId, fromStepId], references: [tenantId, versionId, id], onDelete: Cascade)
  toStep   Step            @relation("TransitionTo", fields: [tenantId, versionId, toStepId], references: [tenantId, versionId, id], onDelete: Cascade)

  ticketEvents TicketEvent[]
  stepVisits   TicketStepVisit[]

  @@id([tenantId, id])
  @@index([tenantId, fromStepId])
  @@index([tenantId, toStepId])
  @@index([tenantId, versionId, fromStepId])
  @@index([tenantId, versionId, toStepId])
  @@index([tenantId, versionId])
  @@map("transitions")
}

/// Dynamic form field. `code` is stable across versions: PDFs, exports and
/// amount rules reference fields by code, not by id.
model Field {
  tenantId   String       @map("tenant_id") @db.Uuid
  id         String       @default(dbgenerated("uuidv7()")) @db.Uuid
  versionId  String       @map("version_id") @db.Uuid
  stepId     String       @map("step_id") @db.Uuid
  code       String
  label      String
  type       FieldType
  capture    CaptureStage @default(BOTH)
  isRequired Boolean      @default(false) @map("is_required")
  isReadOnly Boolean      @default(false) @map("is_read_only")
  sortOrder  Int          @default(0) @map("sort_order")
  config     Json         @default("{}")
  dataSource Json?        @map("data_source")

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version WorkflowVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  step    Step            @relation(fields: [tenantId, versionId, stepId], references: [tenantId, versionId, id], onDelete: Cascade)

  values TicketFieldValue[]

  @@id([tenantId, id])
  @@unique([tenantId, versionId, code])
  @@unique([tenantId, versionId, id])
  @@index([tenantId, stepId])
  @@index([tenantId, versionId, stepId])
  @@map("fields")
}

/// Amount caps: block, warn, or divert to an extra approval step.
model AmountRule {
  tenantId       String           @map("tenant_id") @db.Uuid
  id             String           @default(dbgenerated("uuidv7()")) @db.Uuid
  versionId      String           @map("version_id") @db.Uuid
  stepId         String?          @map("step_id") @db.Uuid
  positionId     String?          @map("position_id") @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  fieldCode      String           @map("field_code")
  rowTypeValue   String?          @map("row_type_value")
  amountColumn   String?          @map("amount_column")
  typeColumn     String?          @map("type_column")
  maxAmount      Decimal          @map("max_amount") @db.Decimal(18, 2)
  currencyCode   String           @map("currency_code") @db.Char(3)
  action         AmountRuleAction
  approvalStepId String?          @map("approval_step_id") @db.Uuid
  message        String?
  isActive       Boolean          @default(true) @map("is_active")

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  version      WorkflowVersion @relation(fields: [tenantId, versionId], references: [tenantId, id], onDelete: Cascade)
  step         Step?           @relation("AmountRuleStep", fields: [tenantId, versionId, stepId], references: [tenantId, versionId, id], onDelete: NoAction)
  approvalStep Step?           @relation("AmountRuleApprovalStep", fields: [tenantId, versionId, approvalStepId], references: [tenantId, versionId, id], onDelete: NoAction)
  position     Position?       @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction)
  company      Company?        @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  currency     Currency        @relation(fields: [currencyCode], references: [code])

  @@id([tenantId, id])
  @@index([tenantId, versionId])
  @@index([currencyCode])
  @@index([tenantId, versionId, approvalStepId])
  @@index([tenantId, companyId])
  @@index([tenantId, positionId])
  @@index([tenantId, versionId, stepId])
  @@map("amount_rules")
}

/// Monthly cutoff day per workflow and company (deadline type CUTOFF).
model CompanyCutoff {
  tenantId          String  @map("tenant_id") @db.Uuid
  id                String  @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId        String  @map("workflow_id") @db.Uuid
  companyId         String  @map("company_id") @db.Uuid
  cutoffDay         Int     @map("cutoff_day") @db.SmallInt
  graceBusinessDays Int     @default(0) @map("grace_business_days") @db.SmallInt
  description       String?
  isActive          Boolean @default(true) @map("is_active")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  company  Company  @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, workflowId, companyId, cutoffDay])
  @@index([tenantId, companyId])
  @@map("company_cutoffs")
}

/// Uploaded spreadsheet used as a lookup source for fields (the old tm_data_excel).
model Dataset {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId     String?  @map("workflow_id") @db.Uuid
  name           String
  columns        Json
  sourceFileName String?  @map("source_file_name")
  loadedAt       DateTime @default(now()) @map("loaded_at") @db.Timestamptz(3)
  isActive       Boolean  @default(true) @map("is_active")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow?    @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: NoAction)
  rows     DatasetRow[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, workflowId])
  @@map("datasets")
}

model DatasetRow {
  tenantId  String  @map("tenant_id") @db.Uuid
  id        String  @default(dbgenerated("uuidv7()")) @db.Uuid
  datasetId String  @map("dataset_id") @db.Uuid
  /// Value of the dataset's key column (e.g. the ID number), indexed for lookups.
  lookupKey String? @map("lookup_key")
  data      Json

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [tenantId, datasetId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, datasetId, lookupKey])
  @@map("dataset_rows")
}

/// Parameters of the built-in calculators (e.g. meal allowance amounts and hours).
model CalculatorConfig {
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  config    Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, code])
  @@map("calculator_configs")
}

// ============================================================================
// Tickets
// ============================================================================

model Ticket {
  tenantId          String                   @map("tenant_id") @db.Uuid
  id                String                   @default(dbgenerated("uuidv7()")) @db.Uuid
  number            BigInt
  workflowId        String                   @map("workflow_id") @db.Uuid
  workflowVersionId String                   @map("workflow_version_id") @db.Uuid
  subcategoryId     String                   @map("subcategory_id") @db.Uuid
  priorityId        String?                  @map("priority_id") @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  departmentId      String?                  @map("department_id") @db.Uuid
  siteId            String?                  @map("site_id") @db.Uuid
  creatorId         String                   @map("creator_id") @db.Uuid
  registeredById    String?                  @map("registered_by_id") @db.Uuid
  title             String
  descriptionHtml   String                   @map("description_html")
  status            TicketStatus             @default(OPEN)
  currentStepId     String?                  @map("current_step_id") @db.Uuid
  currentLoop       Int                      @default(1) @map("current_loop")
  closedAt          DateTime?                @map("closed_at") @db.Timestamptz(3)
  closedById        String?                  @map("closed_by_id") @db.Uuid
  forcedClose       Boolean                  @default(false) @map("forced_close")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// Full-text search over title and description (generated column, Spanish dictionary).
  searchVector      Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow        Workflow          @relation(fields: [tenantId, subcategoryId, workflowId], references: [tenantId, subcategoryId, id], onDelete: NoAction)
  workflowVersion WorkflowVersion   @relation(fields: [tenantId, workflowId, workflowVersionId], references: [tenantId, workflowId, id], onDelete: NoAction)
  subcategory     Subcategory       @relation(fields: [tenantId, subcategoryId], references: [tenantId, id], onDelete: NoAction)
  creatorCompany  MembershipCompany @relation(fields: [tenantId, creatorId, companyId], references: [tenantId, userId, companyId], onDelete: NoAction)
  priority        Priority?         @relation(fields: [tenantId, priorityId], references: [tenantId, id], onDelete: NoAction)
  company         Company           @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  department      Department?       @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: NoAction)
  site            Site?             @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: NoAction)
  creator         Membership        @relation("TicketCreator", fields: [tenantId, creatorId], references: [tenantId, userId], onDelete: NoAction)
  registeredBy    Membership?       @relation("TicketRegisteredBy", fields: [tenantId, registeredById], references: [tenantId, userId], onDelete: NoAction)
  closedBy        Membership?       @relation("TicketClosedBy", fields: [tenantId, closedById], references: [tenantId, userId], onDelete: NoAction)
  currentStep     Step?             @relation(fields: [tenantId, workflowVersionId, currentStepId], references: [tenantId, versionId, id], onDelete: NoAction)

  assignees     TicketAssignee[]
  events        TicketEvent[]
  stepVisits    TicketStepVisit[]
  slaClocks     TicketSlaClock[]
  fieldValues   TicketFieldValue[]
  parallelTasks TicketParallelTask[]
  incidents     TicketIncident[]
  errors        TicketError[]
  tags          TicketTag[]
  signatures    TicketSignature[]
  documents     TicketDocument[]
  exportLines   ExportLine[]
  notifications Notification[]

  @@id([tenantId, id])
  @@unique([tenantId, number])
  @@unique([tenantId, id, workflowVersionId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, creatorId, createdAt(sort: Desc)])
  @@index([tenantId, currentStepId])
  @@index([tenantId, subcategoryId, createdAt(sort: Desc)])
  @@index([tenantId, companyId, createdAt(sort: Desc)])
  @@index([tenantId, closedById])
  @@index([tenantId, creatorId, companyId])
  @@index([tenantId, departmentId])
  @@index([tenantId, priorityId])
  @@index([tenantId, registeredById])
  @@index([tenantId, siteId])
  @@index([tenantId, subcategoryId, workflowId])
  @@index([tenantId, workflowId, workflowVersionId])
  @@index([tenantId, workflowVersionId, currentStepId])
  @@index([searchVector], map: "tickets_search", type: Gin)
  @@map("tickets")
}

/// The ONLY source of truth for who currently holds a ticket.
model TicketAssignee {
  tenantId   String       @map("tenant_id") @db.Uuid
  ticketId   String       @map("ticket_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       AssigneeType
  assignedAt DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, ticketId, userId])
  @@index([tenantId, userId])
  @@map("ticket_assignees")
}

/// Unified timeline: assignments, transitions, comments, incidents, closing, reopening.
model TicketEvent {
  tenantId     String          @map("tenant_id") @db.Uuid
  id           String          @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId     String          @map("ticket_id") @db.Uuid
  type         TicketEventType
  stepId       String?         @map("step_id") @db.Uuid
  transitionId String?         @map("transition_id") @db.Uuid
  loop         Int             @default(1)
  actorId      String?         @map("actor_id") @db.Uuid
  assigneeId   String?         @map("assignee_id") @db.Uuid
  commentHtml  String?         @map("comment_html")
  data         Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Assigned by the database (identity): the order of the timeline, whatever the clocks of the API instances say.
  seq          BigInt          @default(autoincrement())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket      @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  step       Step?       @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  transition Transition? @relation(fields: [tenantId, transitionId], references: [tenantId, id], onDelete: NoAction)
  actor      Membership? @relation("TicketEventActor", fields: [tenantId, actorId], references: [tenantId, userId], onDelete: NoAction)
  assignee   Membership? @relation("TicketEventAssignee", fields: [tenantId, assigneeId], references: [tenantId, userId], onDelete: NoAction)

  documents TicketDocument[]

  @@id([tenantId, id])
  @@index([tenantId, ticketId, createdAt])
  @@index([tenantId, ticketId, seq])
  @@index([tenantId, actorId, createdAt(sort: Desc)])
  @@index([tenantId, assigneeId])
  @@index([tenantId, stepId])
  @@index([tenantId, transitionId])
  @@map("ticket_events")
}

/// One pass of a ticket through a step (a loop back to the same step is a new visit).
/// Measures the TOTAL time of the step; the SLA target is copied when the visit opens
/// so later configuration changes do not rewrite history.
model TicketStepVisit {
  tenantId         String     @map("tenant_id") @db.Uuid
  id               String     @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId         String     @map("ticket_id") @db.Uuid
  stepId           String     @map("step_id") @db.Uuid
  loop             Int        @default(1)
  enteredAt        DateTime   @default(now()) @map("entered_at") @db.Timestamptz(3)
  exitedAt         DateTime?  @map("exited_at") @db.Timestamptz(3)
  exitTransitionId String?    @map("exit_transition_id") @db.Uuid
  slaValue         Int?       @map("sla_value")
  slaUnit          SlaUnit?   @map("sla_unit")
  calendarId       String?    @map("calendar_id") @db.Uuid
  dueAt            DateTime?  @map("due_at") @db.Timestamptz(3)
  pausedMinutes    Int        @default(0) @map("paused_minutes")
  businessMinutes  Int?       @map("business_minutes")
  result           SlaResult?
  /// A ticket parked on a WAIT block is woken up at this time (no SLA, no clocks, no assignees).
  resumeAt         DateTime?  @map("resume_at") @db.Timestamptz(3)
  /// The wake-up event was queued at this time (once).
  resumeEnqueuedAt DateTime?  @map("resume_enqueued_at") @db.Timestamptz(3)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket         Ticket           @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  step           Step             @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  exitTransition Transition?      @relation(fields: [tenantId, exitTransitionId], references: [tenantId, id], onDelete: NoAction)
  calendar       Calendar?        @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: NoAction)
  slaClocks      TicketSlaClock[]

  @@id([tenantId, id])
  @@unique([tenantId, ticketId, stepId, loop])
  @@index([tenantId, calendarId])
  @@index([tenantId, exitTransitionId])
  @@index([tenantId, stepId])
  @@map("ticket_step_visits")
}

/// SLA clock of ONE responsible inside a step visit. See docs/analisis.md §8.2.
/// Reassignment closes the clock and opens a new one; incidents pause it.
/// The SLA target is a snapshot (sla_value/sla_unit/calendar) taken when it opens.
model TicketSlaClock {
  tenantId        String     @map("tenant_id") @db.Uuid
  id              String     @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId        String     @map("ticket_id") @db.Uuid
  visitId         String     @map("visit_id") @db.Uuid
  stepId          String     @map("step_id") @db.Uuid
  loop            Int        @default(1)
  companyId       String     @map("company_id") @db.Uuid
  responsibleId   String?    @map("responsible_id") @db.Uuid
  slaValue        Int?       @map("sla_value")
  slaUnit         SlaUnit?   @map("sla_unit")
  calendarId      String?    @map("calendar_id") @db.Uuid
  startedAt       DateTime   @map("started_at") @db.Timestamptz(3)
  dueAt           DateTime?  @map("due_at") @db.Timestamptz(3)
  pausedAt        DateTime?  @map("paused_at") @db.Timestamptz(3)
  pausedMinutes   Int        @default(0) @map("paused_minutes")
  completedAt     DateTime?  @map("completed_at") @db.Timestamptz(3)
  businessMinutes Int?       @map("business_minutes")
  result          SlaResult?
  /// Why it ended; set together with `completedAt`.
  completionReason ClockCompletionReason? @map("completion_reason")
  alertedAt       DateTime?  @map("alerted_at") @db.Timestamptz(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket      Ticket          @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  visit       TicketStepVisit @relation(fields: [tenantId, visitId], references: [tenantId, id], onDelete: Cascade)
  step        Step            @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  company     Company         @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  responsible Membership?     @relation(fields: [tenantId, responsibleId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, ticketId])
  @@index([tenantId, responsibleId, completedAt])
  @@index([tenantId, companyId])
  @@index([tenantId, stepId])
  @@index([tenantId, visitId])
  @@map("ticket_sla_clocks")
}

/// `workflowVersionId` ties the value to the ticket's version so a field of another
/// version can never be stored. Previous values are kept in ticket_events (FIELDS_UPDATED).
model TicketFieldValue {
  tenantId          String   @map("tenant_id") @db.Uuid
  ticketId          String   @map("ticket_id") @db.Uuid
  workflowVersionId String   @map("workflow_version_id") @db.Uuid
  fieldId           String   @map("field_id") @db.Uuid
  value             Json
  updatedById       String?  @map("updated_by_id") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket    Ticket      @relation(fields: [tenantId, ticketId, workflowVersionId], references: [tenantId, id, workflowVersionId], onDelete: Cascade)
  field     Field       @relation(fields: [tenantId, workflowVersionId, fieldId], references: [tenantId, versionId, id], onDelete: NoAction)
  updatedBy Membership? @relation(fields: [tenantId, updatedById], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, ticketId, fieldId])
  @@index([tenantId, ticketId, workflowVersionId])
  @@index([tenantId, updatedById])
  @@index([tenantId, workflowVersionId, fieldId])
  @@map("ticket_field_values")
}

model TicketParallelTask {
  tenantId    String             @map("tenant_id") @db.Uuid
  id          String             @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId    String             @map("ticket_id") @db.Uuid
  stepId      String             @map("step_id") @db.Uuid
  loop        Int                @default(1)
  userId      String             @map("user_id") @db.Uuid
  status      ParallelTaskStatus @default(PENDING)
  comment     String?
  completedAt DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  step       Step       @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, id])
  @@unique([tenantId, ticketId, stepId, loop, userId])
  @@index([tenantId, stepId])
  @@index([tenantId, userId])
  @@map("ticket_parallel_tasks")
}

/// "Novedad": pauses the ticket and the SLA clock, and hands it to someone else.
/// `previousAssigneeIds` restores the exact assignees when it is resolved.
model TicketIncident {
  tenantId            String         @map("tenant_id") @db.Uuid
  id                  String         @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId            String         @map("ticket_id") @db.Uuid
  stepId              String         @map("step_id") @db.Uuid
  createdById         String         @map("created_by_id") @db.Uuid
  assignedToId        String         @map("assigned_to_id") @db.Uuid
  description         String
  resolution          String?
  status              IncidentStatus @default(OPEN)
  previousAssigneeIds String[]       @map("previous_assignee_ids") @db.Uuid
  openedAt            DateTime       @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt          DateTime?      @map("resolved_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  step       Step       @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  createdBy  Membership @relation("IncidentCreator", fields: [tenantId, createdById], references: [tenantId, userId], onDelete: NoAction)
  assignedTo Membership @relation("IncidentAssignee", fields: [tenantId, assignedToId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, ticketId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, createdById])
  @@index([tenantId, stepId])
  @@index([tenantId, openedAt])
  @@map("ticket_incidents")
}

model ErrorType {
  tenantId       String  @map("tenant_id") @db.Uuid
  id             String  @default(dbgenerated("uuidv7()")) @db.Uuid
  name           String
  description    String?
  isProcessError Boolean @default(false) @map("is_process_error")
  forcesClose    Boolean @default(false) @map("forces_close")
  isReopening    Boolean @default(false) @map("is_reopening")
  isActive       Boolean @default(true) @map("is_active")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subtypes ErrorSubtype[]
  errors   TicketError[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("error_types")
}

model ErrorSubtype {
  tenantId    String  @map("tenant_id") @db.Uuid
  id          String  @default(dbgenerated("uuidv7()")) @db.Uuid
  errorTypeId String  @map("error_type_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  errorType ErrorType     @relation(fields: [tenantId, errorTypeId], references: [tenantId, id], onDelete: Cascade)
  errors    TicketError[]

  @@id([tenantId, id])
  @@unique([tenantId, errorTypeId, name])
  @@map("error_subtypes")
}

/// The only error registry (the old system also stored errors in the assignment history).
/// `isProcessError` is a snapshot of the type at the time it was reported.
model TicketError {
  tenantId       String   @map("tenant_id") @db.Uuid
  id             String   @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  errorTypeId    String   @map("error_type_id") @db.Uuid
  errorSubtypeId String?  @map("error_subtype_id") @db.Uuid
  reporterId     String   @map("reporter_id") @db.Uuid
  responsibleId  String   @map("responsible_id") @db.Uuid
  description    String?
  isProcessError Boolean  @map("is_process_error")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket       Ticket        @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  errorType    ErrorType     @relation(fields: [tenantId, errorTypeId], references: [tenantId, id], onDelete: NoAction)
  errorSubtype ErrorSubtype? @relation(fields: [tenantId, errorSubtypeId], references: [tenantId, id], onDelete: NoAction)
  reporter     Membership    @relation("ErrorReporter", fields: [tenantId, reporterId], references: [tenantId, userId], onDelete: NoAction)
  responsible  Membership    @relation("ErrorResponsible", fields: [tenantId, responsibleId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, ticketId])
  @@index([tenantId, responsibleId, createdAt(sort: Desc)])
  @@index([tenantId, errorSubtypeId])
  @@index([tenantId, errorTypeId])
  @@index([tenantId, reporterId])
  @@index([tenantId, createdAt])
  @@map("ticket_errors")
}

/// Personal tags: each user sees only their own.
model Tag {
  tenantId String @map("tenant_id") @db.Uuid
  id       String @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid
  name     String
  color    String

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner   Membership  @relation(fields: [tenantId, ownerId], references: [tenantId, userId], onDelete: Cascade)
  tickets TicketTag[]

  @@id([tenantId, id])
  @@unique([tenantId, ownerId, name])
  @@unique([tenantId, id, ownerId])
  @@map("tags")
}

model TicketTag {
  tenantId  String   @map("tenant_id") @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tenantId, tagId, userId], references: [tenantId, id, ownerId], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, ticketId, tagId])
  @@index([tenantId, userId])
  @@index([tenantId, tagId, userId])
  @@map("ticket_tags")
}

model TicketSignature {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  stepId     String   @map("step_id") @db.Uuid
  loop       Int      @default(1)
  userId     String   @map("user_id") @db.Uuid
  fileId     String   @map("file_id") @db.Uuid
  isParallel Boolean  @default(false) @map("is_parallel")
  signedAt   DateTime @default(now()) @map("signed_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket     Ticket     @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  step       Step       @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: NoAction)
  file       StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, ticketId, stepId])
  @@index([tenantId, fileId])
  @@index([tenantId, stepId])
  @@index([tenantId, userId])
  @@map("ticket_signatures")
}

// ============================================================================
// Files, see docs/analisis.md §7
// ============================================================================

/// A binary object in S3-compatible storage. `storageKey` is generated
/// (tenants/{tenant}/{yyyy}/{mm}/{uuid}) and never changes; files are never overwritten.
model StoredFile {
  tenantId     String     @map("tenant_id") @db.Uuid
  id           String     @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId    String?    @map("company_id") @db.Uuid
  storageKey   String     @unique @map("storage_key")
  originalName String     @map("original_name")
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  sha256       String     @db.Char(64)
  origin       FileOrigin
  status       FileStatus @default(PENDING)
  uploadedById String?    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt  DateTime?  @map("confirmed_at") @db.Timestamptz(3)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  linkedAt     DateTime?  @map("linked_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company?    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  uploadedBy Membership? @relation("FileUploader", fields: [tenantId, uploadedById], references: [tenantId, userId], onDelete: NoAction)

  membershipSignatures Membership[]      @relation("MembershipSignature")
  stepFiles            StepFile[]
  ticketSignatures     TicketSignature[]
  ticketDocuments      TicketDocument[]
  pdfTemplates         PdfTemplate[]
  exportCutoffs        ExportCutoff[]

  @@id([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, companyId])
  @@index([tenantId, uploadedById])
  @@map("stored_files")
}

/// Links a file to a ticket and says what it is. Generated PDFs are versioned:
/// a new version is a new row with `version + 1` and only one row is `isCurrent`.
model TicketDocument {
  tenantId  String             @map("tenant_id") @db.Uuid
  id        String             @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId  String             @map("ticket_id") @db.Uuid
  fileId    String             @map("file_id") @db.Uuid
  role      TicketDocumentRole
  eventId   String?            @map("event_id") @db.Uuid
  stepId    String?            @map("step_id") @db.Uuid
  fieldCode String?            @map("field_code")
  version   Int                @default(1)
  isCurrent Boolean            @default(true) @map("is_current")
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt DateTime?          @map("deleted_at") @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket       @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  file   StoredFile   @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)
  event  TicketEvent? @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: NoAction)
  step   Step?        @relation(fields: [tenantId, stepId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, ticketId, role])
  @@index([tenantId, eventId])
  @@index([tenantId, fileId])
  @@index([tenantId, stepId])
  @@map("ticket_documents")
}

// ============================================================================
// PDF documents (designer + uploaded template), see docs/analisis.md §7.3
// ============================================================================

model PdfFormat {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId      String   @map("workflow_id") @db.Uuid
  name            String
  description     String?
  design          Json
  fileNamePattern String?  @map("file_name_pattern")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow  Workflow    @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  updatedBy Membership? @relation(fields: [tenantId, updatedById], references: [tenantId, userId], onDelete: NoAction)

  workflowDocuments WorkflowDocument[]

  @@id([tenantId, id])
  @@unique([tenantId, workflowId, name])
  @@index([tenantId, updatedById])
  @@map("pdf_formats")
}

/// PDF uploaded by the customer; fields are placed by coordinates and/or AcroForm names.
model PdfTemplate {
  tenantId    String   @map("tenant_id") @db.Uuid
  id          String   @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  fileId      String   @map("file_id") @db.Uuid
  name        String
  pages       Json
  hasAcroform Boolean  @default(false) @map("has_acroform")
  /// The AcroForm fields found in the PDF when it was registered: `[{name, type, page, rect}]`.
  acroformFields Json  @default("[]") @map("acroform_fields")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow   Workflow               @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  company    Company?               @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  file       StoredFile             @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)
  fields     PdfTemplateField[]
  signatures PdfTemplateSignature[]

  workflowDocuments WorkflowDocument[]

  @@id([tenantId, id])
  @@index([tenantId, companyId])
  @@index([tenantId, fileId])
  @@index([tenantId, workflowId])
  @@map("pdf_templates")
}

/// Coordinates are PDF points with origin at the bottom-left corner of the page.
model PdfTemplateField {
  tenantId     String       @map("tenant_id") @db.Uuid
  id           String       @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId   String       @map("template_id") @db.Uuid
  mode         PdfFieldMode
  fieldCode    String?      @map("field_code")
  expression   String?
  acroformName String?      @map("acroform_name")
  page         Int?         @db.SmallInt
  x            Float?
  y            Float?
  fontSize     Float?       @map("font_size")
  maxWidth     Float?       @map("max_width")
  align        String?

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template PdfTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, templateId])
  @@map("pdf_template_fields")
}

/// Signature slot: `stepName` + `signerType`/`signerLabel` identify which StepSigner fills it
/// (codes are stable across workflow versions).
model PdfTemplateSignature {
  tenantId     String       @map("tenant_id") @db.Uuid
  id           String       @default(dbgenerated("uuidv7()")) @db.Uuid
  templateId   String       @map("template_id") @db.Uuid
  mode         PdfFieldMode
  stepName     String       @map("step_name")
  signerType   SignerType   @map("signer_type")
  signerLabel  String?      @map("signer_label")
  acroformName String?      @map("acroform_name")
  page         Int?         @db.SmallInt
  x            Float?
  y            Float?
  width        Float?
  height       Float?

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template PdfTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, templateId])
  @@map("pdf_template_signatures")
}

/// Which document a workflow produces, for which company and when.
model WorkflowDocument {
  tenantId   String               @map("tenant_id") @db.Uuid
  id         String               @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId String               @map("workflow_id") @db.Uuid
  companyId  String?              @map("company_id") @db.Uuid
  kind       WorkflowDocumentKind
  formatId   String?              @map("format_id") @db.Uuid
  templateId String?              @map("template_id") @db.Uuid
  /// NULL: produced only by a DOCUMENT block.
  moment     DocumentMoment?
  isActive   Boolean              @default(true) @map("is_active")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow     @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  company  Company?     @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  format   PdfFormat?   @relation(fields: [tenantId, formatId], references: [tenantId, id], onDelete: NoAction)
  template PdfTemplate? @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, workflowId])
  @@index([tenantId, companyId])
  @@index([tenantId, formatId])
  @@index([tenantId, templateId])
  @@map("workflow_documents")
}

// ============================================================================
// Scheduled exports (the old "planos")
// ============================================================================

model ExportDefinition {
  tenantId        String          @map("tenant_id") @db.Uuid
  id              String          @default(dbgenerated("uuidv7()")) @db.Uuid
  workflowId      String          @map("workflow_id") @db.Uuid
  companyId       String?         @map("company_id") @db.Uuid
  name            String
  format          ExportFormat    @default(XLSX)
  sheetName       String          @default("Export") @map("sheet_name")
  delimiter       String          @default(";")
  trigger         ExportTrigger
  transitionLabel String?         @map("transition_label")
  filter          Json?
  groupBy         String?         @map("group_by")
  cutoffTime      DateTime        @map("cutoff_time") @db.Time(0)
  frequency       ExportFrequency @default(DAILY)
  weekday         Int?            @db.SmallInt
  monthDay        Int?            @map("month_day") @db.SmallInt
  intervalDays    Int?            @map("interval_days")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow       @relation(fields: [tenantId, workflowId], references: [tenantId, id], onDelete: Cascade)
  company  Company?       @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: NoAction)
  columns  ExportColumn[]
  cutoffs  ExportCutoff[]
  lines    ExportLine[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, companyId])
  @@index([tenantId, workflowId])
  @@map("export_definitions")
}

model ExportColumn {
  tenantId     String             @map("tenant_id") @db.Uuid
  id           String             @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  sortOrder    Int                @map("sort_order")
  header       String
  sourceType   ExportColumnSource @map("source_type")
  sourceRef    String?            @map("source_ref")
  format       ExportValueFormat?

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition ExportDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, definitionId, sortOrder])
  @@map("export_columns")
}

/// Value translation tables used by export columns (e.g. cost center -> cash desk).
model ExportCatalogEntry {
  tenantId    String @map("tenant_id") @db.Uuid
  catalog     String
  inputValue  String @map("input_value")
  outputValue String @map("output_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, catalog, inputValue])
  @@map("export_catalog_entries")
}

model ExportCutoff {
  tenantId      String   @map("tenant_id") @db.Uuid
  id            String   @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId  String   @map("definition_id") @db.Uuid
  cutoffDate    DateTime @map("cutoff_date") @db.Date
  generatedAt   DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)
  generatedById String?  @map("generated_by_id") @db.Uuid
  fileId        String?  @map("file_id") @db.Uuid
  lineCount     Int      @default(0) @map("line_count")
  isManual      Boolean  @default(false) @map("is_manual")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition  ExportDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Cascade)
  generatedBy Membership?      @relation(fields: [tenantId, generatedById], references: [tenantId, userId], onDelete: NoAction)
  file        StoredFile?      @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: NoAction)
  lines       ExportLine[]

  @@id([tenantId, id])
  @@index([tenantId, definitionId, cutoffDate])
  @@index([tenantId, fileId])
  @@index([tenantId, generatedById])
  @@map("export_cutoffs")
}

model ExportLine {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionId  String    @map("definition_id") @db.Uuid
  ticketId      String    @map("ticket_id") @db.Uuid
  data          Json
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(3)
  confirmedById String?   @map("confirmed_by_id") @db.Uuid
  cutoffId      String?   @map("cutoff_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition  ExportDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id], onDelete: Cascade)
  ticket      Ticket           @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)
  confirmedBy Membership?      @relation(fields: [tenantId, confirmedById], references: [tenantId, userId], onDelete: NoAction)
  cutoff      ExportCutoff?    @relation(fields: [tenantId, cutoffId], references: [tenantId, id], onDelete: NoAction)

  @@id([tenantId, id])
  @@unique([tenantId, definitionId, ticketId])
  @@index([tenantId, definitionId, cutoffId])
  @@index([tenantId, confirmedById])
  @@index([tenantId, cutoffId])
  @@index([tenantId, ticketId])
  @@map("export_lines")
}

// ============================================================================
// Notifications, outbox, webhooks, audit
// ============================================================================

model Notification {
  tenantId  String           @map("tenant_id") @db.Uuid
  id        String           @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  ticketId  String?          @map("ticket_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The outbox event that produced it: one notification per person per event.
  sourceEventId String?      @map("source_event_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  ticket     Ticket?    @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, sourceEventId, userId])
  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, ticketId])
  @@map("notifications")
}

/// Per-user channel preferences. No row = defaults (in-app and e-mail enabled).
model NotificationPreference {
  tenantId String           @map("tenant_id") @db.Uuid
  userId   String           @map("user_id") @db.Uuid
  type     NotificationType
  inApp    Boolean          @default(true) @map("in_app")
  email    Boolean          @default(true)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, userId, type])
  @@map("notification_preferences")
}

/// Transactional outbox: side effects (PDF, e-mail, websocket, webhooks, exports)
/// are written here inside the business transaction and processed by the worker.
model OutboxEvent {
  tenantId    String       @map("tenant_id") @db.Uuid
  id          String       @default(dbgenerated("uuidv7()")) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@map("outbox_events")
}

/// Types of platform events the API may enqueue (whitelist checked by enqueue_platform_event).
model PlatformEventType {
  type        String @id
  description String

  events PlatformOutboxEvent[]

  @@map("platform_event_types")
}

/// Outbox of events that belong to no tenant (e.g. the password reset e-mail). No access for
/// app_runtime or app_worker: only the SECURITY DEFINER functions touch it.
model PlatformOutboxEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  eventType PlatformEventType @relation(fields: [type], references: [type], onDelete: NoAction, onUpdate: NoAction)

  @@index([type])
  @@map("platform_outbox_events")
}

/// Append-only trail of platform actions (they bypass row-level security). No tenant_id and no foreign keys.
model PlatformAuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId    String   @map("actor_user_id") @db.Uuid
  action         String
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  data           Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetTenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("platform_audit_logs")
}

model Webhook {
  tenantId        String   @map("tenant_id") @db.Uuid
  id              String   @default(dbgenerated("uuidv7()")) @db.Uuid
  url             String
  /// Signing secret encrypted by the application (AES-256-GCM): HMAC signing needs the clear value.
  secretEncrypted Bytes    @map("secret_encrypted")
  events          String[]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@id([tenantId, id])
  @@map("webhooks")
}

model WebhookDelivery {
  tenantId       String    @map("tenant_id") @db.Uuid
  id             String    @default(dbgenerated("uuidv7()")) @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  attempts       Int       @default(0)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook Webhook @relation(fields: [tenantId, webhookId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, webhookId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model AuditLog {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  Membership? @relation(fields: [tenantId, actorId], references: [tenantId, userId], onDelete: NoAction)

  @@id([tenantId, id])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, actorId])
  @@map("audit_logs")
}

// ============================================================================
// Personal text templates (snippets)
// ============================================================================

model TextTemplate {
  tenantId  String   @map("tenant_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  title     String
  bodyHtml  String   @map("body_html")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner  Membership          @relation(fields: [tenantId, ownerId], references: [tenantId, userId], onDelete: Cascade)
  shares TextTemplateShare[]

  @@id([tenantId, id])
  @@index([tenantId, ownerId])
  @@map("text_templates")
}

model TextTemplateShare {
  tenantId   String @map("tenant_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   TextTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  membership Membership   @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)

  @@id([tenantId, templateId, userId])
  @@index([tenantId, userId])
  @@map("text_template_shares")
}
