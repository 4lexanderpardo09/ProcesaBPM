NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Runtime login (member of app_runtime). Through PgBouncer in transaction mode in production.
DATABASE_URL=postgresql://procesabpm_api:change-me@localhost:5432/procesabpm
# Worker login (member of app_worker; read by the worker entry only, never by the API).
WORKER_DATABASE_URL=postgresql://procesabpm_worker:change-me@localhost:5432/procesabpm
# Platform login (member of app_platform). Only for platform services (provisioning, purges).
PLATFORM_DATABASE_URL=postgresql://procesabpm_platform:change-me@localhost:5432/procesabpm

# Signing key of the access tokens (HS256). At least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# AES-256 keys for stored MFA secrets: "id:base64,...", first one encrypts (openssl rand -base64 32). API only.
MFA_ENCRYPTION_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Proxies allowed to set X-Forwarded-For: false (none), the number of proxies in front of the API,
# or their addresses/CIDRs comma-separated. Never true. Default: false.
TRUST_PROXY=false

# Database tuning (optional; these are the defaults).
# Interactive transaction timeout in milliseconds (Prisma's own default is 5000).
DB_TX_TIMEOUT_MS=10000
# How long a transaction may wait for a free connection, in milliseconds (Prisma's own default is 2000).
DB_TX_MAX_WAIT_MS=5000
# Connections of the runtime pool.
DB_POOL_MAX=10
