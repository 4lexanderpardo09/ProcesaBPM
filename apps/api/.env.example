NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Runtime login (member of app_runtime). Through PgBouncer in transaction mode in production.
DATABASE_URL=postgresql://procesabpm_api:change-me@localhost:5432/procesabpm
# Platform login (member of app_platform). Only for platform services (provisioning, purges).
PLATFORM_DATABASE_URL=postgresql://procesabpm_platform:change-me@localhost:5432/procesabpm

# Database tuning (optional; these are the defaults).
# Interactive transaction timeout in milliseconds (Prisma's own default is 5000).
DB_TX_TIMEOUT_MS=10000
# How long a transaction may wait for a free connection, in milliseconds (Prisma's own default is 2000).
DB_TX_MAX_WAIT_MS=5000
# Connections of the runtime pool.
DB_POOL_MAX=10
