NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Runtime login (member of app_runtime). Through PgBouncer in transaction mode in production.
DATABASE_URL=postgresql://procesabpm_api:change-me@localhost:5432/procesabpm
# Platform login (member of app_platform). Only for platform services (provisioning, purges).
PLATFORM_DATABASE_URL=postgresql://procesabpm_platform:change-me@localhost:5432/procesabpm
